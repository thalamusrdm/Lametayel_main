{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/client",
  "functions": {
    "api/legacy.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/blog/blog4",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/legacy/:path*",
      "destination": "/api/legacy?path=:path*"
    },
    {
      "source": "/wizard",
      "destination": "/api/legacy?path=wizard"
    },
    {
      "source": "/wizard/:path*",
      "destination": "/api/legacy?path=wizard/:path*"
    },
    {
      "source": "/buy/step1",
      "destination": "/index.html"
    },
    {
      "source": "/buy/:path*",
      "destination": "/api/legacy?path=buy/:path*"
    },
    {
      "source": "/blog",
      "destination": "/seo/blog.html"
    },
    {
      "source": "/blog/blog1",
      "destination": "/seo/blog/blog1.html"
    },
    {
      "source": "/blog/blog2",
      "destination": "/seo/blog/blog2.html"
    },
    {
      "source": "/blog/blog3",
      "destination": "/seo/blog/blog3.html"
    },
    {
      "source": "/blog/blog5",
      "destination": "/seo/blog/blog5.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/legacy?path=assets/:path*"
    },
    {
      "source": "/system/:path*",
      "destination": "/api/legacy?path=system/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
